# Root-level environment file for Docker Compose.
# Copy this to .env and fill in the values before running `docker compose up`.

# --- PostgreSQL Database ---
POSTGRES_USER=aias
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aias_db

# --- Shared JWT Secret ---
# Must match AUTH_SECRET in frontend/.env.local
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Initial Admin Users ---
# Comma-separated list of Google email addresses to seed as admins on first startup.
# These users will be created with role='admin' if they don't exist yet.
INITIAL_ADMINS=admin@example.com

# --- URLs ---
# Frontend URL (used for CORS on backend)
FRONTEND_URL=https://your-domain.com

# Backend WebSocket URL (reachable from browser — for realtime transcription)
# Same host as frontend if using nginx /ws/ proxy, or separate backend domain
BACKEND_WS_URL=wss://your-domain.com/ws
